function onOpen(){const ui=SpreadsheetApp.getUi();ui.createMenu('Order Bếp').addItem('Lưu order hôm nay và xoá số','luuOrder').addToUi();}
function luuOrder(){const ui=SpreadsheetApp.getUi();const ss=SpreadsheetApp.getActive();const ob=ss.getSheetByName('Order Bếp');const last=ob.getLastRow();const ngay=ob.getRange('B2').getValue();const rows=ob.getRange(5,1,Math.max(last-4,1),8).getValues().filter(r=>r[2]!==''&&(r[4]!==''||r[6]!==''||r[7]!=='')).map(r=>[ngay,r[5],r[2],r[3],r[4],r[6],r[7]]);rows.length==0&&ui.alert('Chưa có món nào có SL đặt / SL nhận / Ghi chú.');const go=rows.length>0&&ui.alert('Lưu '+rows.length+' món vào tab Lịch sử order rồi xoá cột SL đặt, SL nhận và Ghi chú?',ui.ButtonSet.YES_NO)==ui.Button.YES;go&&luu(ss,ob,rows,last,ui);}
function luu(ss,ob,rows,last,ui){const ls=ss.getSheetByName('Lịch sử order')||ss.insertSheet('Lịch sử order');ls.getLastRow()==0&&ls.appendRow(['Ngày','NCC','Món','ĐVT','SL đặt','SL nhận','Ghi chú'])&&ls.getRange(1,1,1,7).setFontWeight('bold')&&ls.setFrozenRows(1);const start=ls.getLastRow()+1;ls.getRange(start,1,rows.length,7).setValues(rows);ls.getRange(start,1,rows.length,1).setNumberFormat('dd/mm/yyyy');ob.getRange(5,5,last-4,1).clearContent();ob.getRange(5,7,last-4,2).clearContent();ui.alert('Đã lưu '+rows.length+' món vào tab Lịch sử order. Cột SL đặt, SL nhận, Ghi chú đã được xoá trống.');}
